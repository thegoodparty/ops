# delegate-swarm.infra.goodparty.org: serve the self-built dashboard SPA from
# /srv/ui and reverse-proxy every API path to the api container.
#
# API prefixes (agent-swarm v2.10.0):
#   /api/*          every REST route (src/http/*.ts: path: "/api/...")
#   /p/*            public page views     (src/http/pages-public.ts)
#   /@swarm/*       page SDK + proxy      (src/http/page-proxy.ts, realtime.ts)
#   /agentfs/*      agent-fs proxy        (src/http/agentfs-proxy.ts)
#   /share/* /site/*  public agent-fs pages, same proxy
#   /mcp            swarm MCP endpoint    (src/http/mcp.ts)
#   /mcp-user       user-token MCP        (src/http/mcp-user.ts)
#   /health /openapi.json /docs           (src/http/core.ts)
#   /status /status/test-connection        (src/http/status.ts)
#   /ping /close                          (src/http/core.ts)
#   /invite/*       invite link redirect   (src/http/users.ts)
#
# The three agent-fs prefixes are routed so that /agentfs, /share and /site
# never fall through to the SPA and answer a file preview with index.html.
# AGENT_FS_PROXY is pinned off in docker-compose.yml, so the API 404s them
# until someone turns it on (README, "Shared files").
# None of these collide with SPA routes (apps/ui/src/app/routes.tsx: /agents
# /tasks /sessions /chat /services /schedules /workflows /workflow-runs
# /connections /scripts /script-runs /approval-requests /usage /settings
# /templates /mcp-servers /skills /repos /people /memory /pages /apps /file
# /setup /connect /join /integrations).
#
# SWARM_AUTH (set by render-env.sh, passed to the caddy container) picks the
# snippet: "open" (bearer auth only) or "sso" (Google login via oauth2-proxy
# in front of everything except machine callers).

(spa) {
	root * /srv/ui

	# index.html and version.json carry the build id the SPA polls to
	# prompt a reload (apps/ui/vite.config.ts buildVersionManifest), so
	# they must never be cached. Hashed assets are immutable.
	@nocache path / /index.html /version.json
	header @nocache Cache-Control "no-cache"
	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"

	try_files {path} /index.html
	file_server
}

(open) {
	@api path /api/* /p/* /@swarm/* /agentfs/* /share/* /site/* /mcp /mcp-user /health /status /status/* /invite/* /docs /docs/* /openapi.json /ping /close
	handle @api {
		reverse_proxy api:3013
	}

	handle {
		import spa
	}
}

(sso) {
	# The API reads no identity from the login, so the signed-in address picks
	# that person's own aswt_ token (sync-dashboard-users.sh writes the
	# entries). Only oauth2-proxy may set the address: drop any client copy.
	request_header -X-Auth-Request-Email
	map {http.request.header.X-Auth-Request-Email} {swarm_user_token} {
		import /etc/caddy/dashboard-tokens.caddy
		default ""
	}

	# oauth2-proxy's own endpoints: login start, Google callback, sign out.
	handle /oauth2/* {
		reverse_proxy oauth2-proxy:4180 {
			header_up X-Real-IP {remote_host}
			header_up X-Forwarded-Uri {uri}
		}
	}

	# Machine callers with their own bearer or signature, and IdP callbacks
	# that carry their own state: no browser cookie.
	@noauth path /mcp /mcp-user /share/* /site/* /health /status /invite/* /ping /api/webhooks/* /api/github/webhook /api/gitlab/webhook /api/azure-devops/webhook /api/agentmail/webhook /api/integrations/kapso/webhook /api/mcp-oauth/callback /api/oauth/callback /api/oauth/*/callback
	handle @noauth {
		reverse_proxy api:3013
	}

	handle {
		forward_auth oauth2-proxy:4180 {
			uri /oauth2/auth
			copy_headers X-Auth-Request-User X-Auth-Request-Email X-Auth-Request-Groups X-Forwarded-User X-Forwarded-Email

			# Browser navigations go to the login page; fetches from the SPA
			# get a plain 401 instead of a redirect into Google's HTML.
			@error status 401 403
			handle_response @error {
				@navigation header Accept *text/html*
				redir @navigation /oauth2/start?rd={http.request.uri_escaped} 302
				respond 401
			}
		}

		# The dashboard is built with a placeholder key (build-ui.sh); the API
		# gets the signed-in person's token instead.
		@api path /api/* /p/* /@swarm/* /agentfs/* /status/* /docs /docs/* /openapi.json /close
		handle @api {
			@unprovisioned vars {swarm_user_token} ""
			respond @unprovisioned "Signed in, but this address has no dashboard token (allowed-emails.txt, sync-dashboard-users.sh)" 403
			reverse_proxy api:3013 {
				header_up Authorization "Bearer {swarm_user_token}"
			}
		}

		# Temporary: live view of the Scale to Win sign-in browser that runs in
		# worker-coder (2026-11-11, Tomer Almog). agent-browser's dashboard binds
		# 127.0.0.1:4848 inside that container; a socat relay publishes it on the
		# compose network as worker-coder:14848. Nothing is published on the host,
		# and every path below sits behind the same Google login as the dashboard.
		#
		# The dashboard is a root-origin Next.js app: the page loads at /s2w/ but
		# it asks for /_next/*, its own /api/* and two root assets, so those are
		# routed to it too. /api/sessions is the one path the swarm API answers as
		# well, so it goes to the dashboard only for a browser that came from
		# /s2w (the dashboard rejects any other Referer itself). Delete this block
		# and stop the dashboard and the relay once the sign-in is done.
		handle /s2w {
			redir * /s2w/ 308
		}

		handle_path /s2w/* {
			reverse_proxy worker-coder:14848
		}

		@s2w_paths path /_next/* /favicon.ico /lightpanda.svg /providers/* /api/session/* /api/exec /api/kill /api/chat /api/chat/status /api/models
		handle @s2w_paths {
			reverse_proxy worker-coder:14848
		}

		@s2w_sessions {
			path /api/sessions
			header Referer */s2w/*
		}
		handle @s2w_sessions {
			reverse_proxy worker-coder:14848
		}

		handle {
			import spa
		}
	}
}

delegate-swarm.infra.goodparty.org {
	encode zstd gzip

	import {$SWARM_AUTH:open}
}
