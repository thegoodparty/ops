# =============================================================================
# TEMPLATE ONLY — do not fill this in and commit it.
#
# Real values live in the AGENT_SWARM AWS Secrets Manager secret. bootstrap.sh
# renders them onto the host as /opt/agent-swarm/.env at first boot. Copy this
# file to .env only to hand-run the stack on a scratch box.
# =============================================================================

# ---- Image version ----
# Both swarm images resolve their tag from this value. Blank tracks `latest`,
# which upstream rebuilds on every commit to main; pin a release instead and
# keep the API and every agent on the same value.
# Releases: https://github.com/desplega-ai/agent-swarm/releases
AGENT_SWARM_VERSION=1.158.0

# ---- Harness and model ----
# pi is the only harness this stack runs. With ANTHROPIC_API_KEY set it resolves
# the native Anthropic provider. Do NOT also set CLAUDE_CODE_OAUTH_TOKEN — pi
# alongside a Claude OAuth token is documented as wrong.
HARNESS_PROVIDER=pi
MODEL_OVERRIDE=anthropic/claude-sonnet-5
ANTHROPIC_API_KEY=

# Semantic memory search needs an embedding provider. Without OPENAI_API_KEY or
# EMBEDDING_API_KEY, memory search falls back to full-text search. That fallback
# is accepted here: GoodParty holds Anthropic credentials only.
OPENAI_API_KEY=

# Workflow LLM nodes do not support Anthropic. Do not build workflows with LLM
# nodes on this deployment; agents reach models through pi instead.
MEMORY_RATERS=implicit-citation,explicit-self

# ---- API authentication ----
# API_KEY is the reserved control-plane credential, and the one the agents and
# the bridge authenticate with. AGENT_SWARM_API_KEY is agent-swarm's preferred
# alias for it, but this stack sets only API_KEY: the lookup is
# `AGENT_SWARM_API_KEY ?? API_KEY ?? ""`, so declaring the alias as an empty
# string would win the nullish check and leave the API with an empty key. Set it
# only if you set it to a real value.
API_KEY=
# At-rest key for swarm_config's secret rows (AES-256-GCM). Supplied here rather
# than auto-generated beside the database, because Litestream replicates the
# database and not that file: a restore from S3 would otherwise recover rows
# nobody could decrypt. Losing this value loses every encrypted secret with no
# recovery path, so it is held in Secrets Manager and never regenerated.
SECRETS_ENCRYPTION_KEY=

# ---- Public URLs ----
# PUBLIC_MCP_BASE_URL is the ALB-fronted origin for OAuth redirects, webhooks,
# and the dashboard. APP_URL is the hosted UI used in Slack and PR links.
PUBLIC_MCP_BASE_URL=https://agent-swarm.goodparty.org
APP_URL=https://app.agent-swarm.dev
# Blank keeps upstream's default allowlist. Set it to the dashboard origin when
# self-hosting the UI.
CORS_ALLOWED_ORIGINS=

# ---- Slack (Socket Mode, outbound only) ----
# The app dials out, so the host needs no public Slack route and no signing
# secret. SWARM_INCIDENT_CHANNEL is our own convention rather than an agent-swarm
# setting: the incident channel's ID, which the lead reads from its environment.
# The API also uses it as SLACK_ALERTS_CHANNEL, where the swarm reports its own
# failures.
SWARM_INCIDENT_CHANNEL=
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=

# ---- GitHub ----
# GITHUB_TOKEN must push branches and open pull requests. A PAT works today; a
# GitHub App installation is preferred long-term (scoped, rotatable, not tied to
# one person's account). The author identity is what the swarm's commits carry,
# so it should not be a person's name or address.
GITHUB_TOKEN=
GITHUB_EMAIL=agent-swarm@goodparty.org
GITHUB_NAME=Agent Swarm

# ---- Agent identity ----
# Leave blank: each service generates a UUID on first boot and persists it at
# /var/lib/agent-swarm/personal/<name>/.agent-id. Set one to pin an identity;
# keep it to retain that agent's task history.
# LEAD_AGENT_ID=
# CODER_1_AGENT_ID=
# CODER_2_AGENT_ID=

# ---- Grafana alert bridge ----
# Shared with the Grafana webhook contact point. The secret signs the payload;
# the password authenticates the request.
GRAFANA_WEBHOOK_SECRET=
GRAFANA_BASIC_AUTH_PASSWORD=

# ---- Grafana, read-only, for the agents ----
# Agents investigate by querying Loki. This is the same route BugBoss's agents
# use and it is the difference between an incident that carries evidence and one
# that carries a guess. The service account token is read-only: there is no path
# from here to changing a dashboard, a rule or an alert.
GRAFANA_URL=https://goodparty.grafana.net
GRAFANA_SERVICE_ACCOUNT_TOKEN=
LOKI_DATASOURCE_UID=grafanacloud-logs

# ---- Litestream (SQLite -> S3) ----
# No keys. The host's instance profile already reads and writes the bucket, and
# Litestream falls back to the SDK credential chain. litestream.yml carries the
# reasoning, and the fallback if that assumption turns out to be wrong.

# ---- Durability ----
# Litestream replicates the database to S3, and the encryption key above travels
# in Secrets Manager rather than on the host, so a rebuild restores a database
# that can still be read. Both are required for the record to survive; neither
# is sufficient alone.
