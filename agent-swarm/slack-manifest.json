{
  "display_information": {
    "name": "delegate",
    "description": "GoodParty's engineering agent",
    "background_color": "#1f2937",
    "long_description": "Self-hosted agent-swarm for the GoodParty engineering team. Ask delegate in a channel, a DM, or the assistant pane; it delegates to coding agents, runs scheduled jobs, and builds internal apps."
  },
  "features": {
    "app_home": {
      "home_tab_enabled": true,
      "messages_tab_enabled": true,
      "messages_tab_read_only_enabled": false
    },
    "bot_user": {
      "display_name": "delegate",
      "always_online": true
    },
    "slash_commands": [
      {
        "command": "/agent-swarm-status",
        "description": "Check status of available agents",
        "should_escape": false
      },
      {
        "command": "/agent-swarm-help",
        "description": "Show help for using the Agent Swarm bot",
        "should_escape": false
      }
    ],
    "agent_view": {
      "agent_description": "Talk to delegate, the GoodParty engineering agent",
      "suggested_prompts": []
    },
    "rich_previews": {
      "is_active": true,
      "entity_types": [
        "slack#/entities/file",
        "slack#/entities/task",
        "slack#/entities/item",
        "slack#/entities/content_item"
      ]
    }
  },
  "oauth_config": {
    "scopes": {
      "bot": [
        "app_mentions:read",
        "assistant:write",
        "channels:history",
        "channels:read",
        "chat:write",
        "chat:write.public",
        "commands",
        "files:read",
        "files:write",
        "groups:history",
        "groups:read",
        "im:history",
        "im:read",
        "im:write",
        "mpim:history",
        "mpim:read",
        "mpim:write",
        "reactions:write",
        "users:read",
        "channels:join",
        "channels:manage",
        "users:read.email"
      ]
    },
    "pkce_enabled": false
  },
  "settings": {
    "event_subscriptions": {
      "bot_events": [
        "app_mention",
        "entity_details_requested",
        "message.channels",
        "message.groups",
        "message.im",
        "message.mpim",
        "assistant_thread_started",
        "assistant_thread_context_changed"
      ]
    },
    "interactivity": {
      "is_enabled": true
    },
    "org_deploy_enabled": false,
    "socket_mode_enabled": true,
    "token_rotation_enabled": false,
    "is_mcp_enabled": true
  }
}
