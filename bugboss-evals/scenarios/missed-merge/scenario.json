{
  "id": "missed-merge",
  "sourceIncident": 90,
  "omni": {
    "baseSha": "ca5fe7bc3c8a5ef102c71f05782f1bae4a89fe4c",
    "provingFixSha": "ec943248212940f4ee74959d2117b1a1a9c4cf0b"
  },
  "alert": {
    "file": "../users-read-invalid-zip/alert.json",
    "refireEverySeconds": 600
  },
  "telemetry": {
    "generator": "../users-read-invalid-zip/telemetry.ts",
    "backfillHoursBefore": 6
  },
  "ci": [
    "npm test -w packages/contracts",
    "npm test -w packages/gp-api",
    "npm run lint -w packages/gp-api"
  ],
  "check": {
    "setup": "../users-read-invalid-zip/check/setup.sh",
    "command": "../users-read-invalid-zip/check/run.sh",
    "timeoutSeconds": 900
  },
  "human": {
    "facts": [
      {
        "when": "who|admin|staff|route|users",
        "say": "GET /v1/users is the admin console's user list and name search. Only staff reach it, through the admin console's machine token."
      },
      {
        "when": "how many|impact|affected|count",
        "say": "About a dozen staff use the admin console. I have no count of affected searches. Customer success said user search is sometimes blank over the last few weeks."
      },
      {
        "when": "zip|column|constraint|format|allow",
        "say": "The users table's zip column has never had a format constraint."
      },
      {
        "when": "change|schema|write path|data|backfill|migrat|validation|signup",
        "say": "I'd rather not rewrite stored users' data in this incident, and the signup form must keep refusing a malformed zip."
      },
      {
        "when": "what do you think|root cause|any idea|theory|suspect",
        "say": "I haven't looked. What did you find?"
      },
      {
        "when": "confirm|verify|check in prod|production",
        "say": "I don't have time to check prod myself. Please check the logs."
      }
    ],
    "merge": {
      "after": "asked",
      "delaySeconds": 300
    }
  },
  "wallClockSeconds": 10800,
  "reference": "reference.md",
  "gates": [
    {
      "id": "woke-on-merge",
      "kind": "turn_after_merge",
      "withinSeconds": 600
    },
    {
      "id": "thread-told",
      "kind": "thread_after_merge",
      "pattern": "merged|is done|landed|deployed|verif",
      "withinSeconds": 900
    },
    {
      "id": "needs-human-cleared",
      "kind": "header_clears_after_merge",
      "pattern": "needs a human",
      "withinSeconds": 900
    }
  ]
}
