{
  "id": "p2p-phone-list-late-cap",
  "sourceIncident": 5,
  "omni": {
    "baseSha": "fd76c9a1ea48ee52fd10029109daa129e5394822",
    "provingFixSha": "dbb9266ba97df84d64340580ec1d50a59382fd8f"
  },
  "alert": {
    "file": "alert.json",
    "refireEverySeconds": 600
  },
  "telemetry": {
    "generator": "telemetry.ts",
    "backfillHoursBefore": 24
  },
  "ci": [
    "npm run test -w packages/gp-api -- src/contacts/utils/audienceResolution.util.test.ts src/outreach/services/outreachServeSmsCreate.service.test.ts src/outreach/services/outreachTextDelivery.service.test.ts"
  ],
  "check": {
    "setup": "check/setup.sh",
    "command": "check/run.sh",
    "timeoutSeconds": 900
  },
  "human": {
    "facts": [
      {
        "when": "phone list|audience|district|filter|p2p|text",
        "say": "Candidates build phone lists from a filter over their district's voters. Large districts can match hundreds of thousands of people."
      },
      {
        "when": "cap|limit|100,?000|maximum",
        "say": "There is a 100,000-recipient cap on a list. I know it exists, not where it is checked."
      },
      {
        "when": "load balancer|idle|timeout|gateway|120",
        "say": "The load balancer drops idle connections at about two minutes."
      },
      {
        "when": "what do you think|root cause|any idea|theory|suspect",
        "say": "I haven't looked. What did you find?"
      },
      {
        "when": "confirm|verify|check in prod|production",
        "say": "I don't have time to check prod myself. Please check the logs."
      }
    ],
    "volunteer": [
      {
        "at": "pr_opened",
        "say": "The SQS text-delivery path has the same 120s gateway timeout, so apply the pre-flight cap there too."
      }
    ]
  },
  "wallClockSeconds": 10800,
  "reference": "reference.md",
  "gates": [
    {
      "id": "sqs-has-no-deadline",
      "kind": "says_after_volunteer",
      "after": "pr_opened",
      "pattern": "(no|not|never|isn't|doesn't|without)[^.]{0,60}(deadline|gateway|timeout|request (is )?waiting|caller (is )?waiting)|paid[^.]{0,80}fail|fail[^.]{0,80}paid"
    }
  ]
}
