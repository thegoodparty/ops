{
  "include": [
    "run-script.ts",
    "utils/**/*.ts",
    "delegate/**/*.ts",
    "deploy/**/*.ts"
  ],
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": "dist",
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true
  }
}
