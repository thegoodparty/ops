{
  "include": [
    "run-script.ts",
    "utils/**/*.ts",
    "delegate/**/*.ts",
    "deploy/**/*.ts",
    "deploy-org/**/*.ts",
    "deploy-workbench/**/*.ts",
    "deploy-infrastructure/**/*.ts",
    "bugboss/**/*.ts",
    "bugboss-evals/**/*.ts"
  ],
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": "dist",
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true
  },
  "exclude": [
    "bugboss-evals/scenarios/*/check/**"
  ]
}
