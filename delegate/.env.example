# All keys below are stored in AWS Secrets Manager under the secret name
# DELEGATES and mirrored into the Fargate task environment by Pulumi. Locally,
# copy this file to .env and fill in real values for `npm run worker:dev`.

# Anthropic
ANTHROPIC_API_KEY=

# Slack
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=

# GitHub App (delegate[bot])
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=

# ClickUp
CLICKUP_API_TOKEN=

# Observability
DATABRICKS_TOKEN=
GRAFANA_SERVICE_ACCOUNT_TOKEN=
SENTRY_AUTH_TOKEN=

# Set by the worker entrypoint at boot for workflow agents — do NOT put these
# in the secret. Override only if you need a non-default for local testing.
# OMNI_DIR=/app/omni  (worker sparse-clones omni here)
# RUNBOOKS_DIR=/app/omni/packages/runbooks
# RUNBOOKS_SHA=<captured at boot from `git rev-parse HEAD` of the omni clone>
# CLICKUP_API_KEY=<mirrored from CLICKUP_API_TOKEN so runbooks scripts work unchanged>
# CLICKUP_TEAM_ID=90132012119  (default constant in delegate/worker/entrypoint.ts)

# pr-reviewer second-opinion pass (GPT-5.6 Sol on Bedrock). NOT secrets — do
# NOT put these in the DELEGATES secret. Every one has a code default; set one
# only to override it. Auth is SigV4 as the ECS task role, so there is no API
# key here to store. The pass runs with no shell and no GitHub token — only
# read-only tools confined to the PR checkout — because it drives a model over
# untrusted PR content.
# SECOND_OPINION_ENABLED=true  ("false" skips the second pass entirely)
# SECOND_OPINION_MODEL=us.openai.gpt-5.6-sol  (Bedrock inference-profile id)
# SECOND_OPINION_REGION=us-west-2  (defaults to AWS_REGION)
# SECOND_OPINION_MAX_USD=6  (hard spend ceiling for the whole second pass)
# SECOND_OPINION_MAX_LEADS=10  (cap on deep-reviewers dispatched)
# SECOND_OPINION_FILE=/app/second-opinion.json  (where the result JSON lands)
# PR_DIFF_FILE=/app/pr-diff.patch  (worker captures `gh pr diff` here at boot)
# REVIEW_REPO / REVIEW_PR_NUMBER / REVIEW_DIR  (set by the entrypoint at boot)
