# All keys below are stored in AWS Secrets Manager under the secret name
# DELEGATES and mirrored into the Fargate task environment by Pulumi. The task
# definition's key list is declared in `deploy/delegate-secret.ts`, which is the
# source of truth; keep this file in sync when that list changes. Locally, copy
# this file to .env and fill in real values for `npm run worker:dev`.

# Anthropic
ANTHROPIC_API_KEY=

# Slack
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=

# Verifies GitHub webhook deliveries in the Lambda.
GITHUB_WEBHOOK_SECRET=

# GitHub App (delegate-reviewer). pr-reviewer runs entirely as this App.
# Required: pr-reviewer exits at boot without it.
REVIEWER_APP_PRIVATE_KEY=

# ClickUp. `CLICKUP_API_TOKEN` is what the worker reads; `CLICKUP_TOKEN` is not
# referenced in this repo.
CLICKUP_API_TOKEN=
CLICKUP_TOKEN=

# Observability
DATABRICKS_TOKEN=
GRAFANA_SERVICE_ACCOUNT_TOKEN=
GRAFANA_WEBHOOK_SECRET=
SENTRY_AUTH_TOKEN=

# Not referenced in this repo; supplied by the secret and passed to the task.
WORKFLOW_USERS=

# Set by the worker entrypoint at boot for workflow agents — do NOT put these
# in the secret. Override only if you need a non-default for local testing.
# OMNI_DIR=/app/omni  (worker sparse-clones omni here)
# RUNBOOKS_DIR=/app/omni/packages/runbooks
# RUNBOOKS_SHA=<captured at boot from `git rev-parse HEAD` of the omni clone>
# CLICKUP_API_KEY=<mirrored from CLICKUP_API_TOKEN so runbooks scripts work unchanged>
# CLICKUP_TEAM_ID=90132012119  (default constant in delegate/worker/entrypoint.ts)
